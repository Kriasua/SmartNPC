#!/bin/sh
# Secret scan before every commit — see Tools/Check-ForSecrets.ps1
#
# Install once per clone:
#   git config --local core.hooksPath Tools/githooks
#
# This lives in the repository on purpose: a hook in .git/hooks is machine-local,
# invisible to review, and gone after a fresh clone.
#
# One-off bypass (use sparingly, and say why in the commit message):
#   git commit --no-verify

root=$(git rev-parse --show-toplevel)

for sh in pwsh powershell; do
  if command -v "$sh" >/dev/null 2>&1; then
    "$sh" -NoProfile -ExecutionPolicy Bypass -File "$root/Tools/Check-ForSecrets.ps1" || exit 1
    exit 0
  fi
done

echo "Check-ForSecrets: no PowerShell found, skipping secret scan." >&2
exit 0
